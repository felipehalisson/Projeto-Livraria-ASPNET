@{
    ViewData["Title"] = "Home";
    var nomeUsuario = Context.Session.GetString("UsuarioNome");
}

<div class="text-center mt-4">
    <h1 class="display-5">Bem-vindo, @nomeUsuario!</h1>
    <p class="lead">Gerencie o acervo da livraria.</p>

    <a class="btn btn-primary btn-lg mt-3" asp-controller="Livro" asp-action="Create">Cadastrar Livros</a>
</div>